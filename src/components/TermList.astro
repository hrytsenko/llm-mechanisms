---
// Lists the terms in one directory with their tier and definition, in sidebar order.
import { getCollection } from 'astro:content';
import { Badge } from '@astrojs/starlight/components';
import { tierBadges } from '../tiers';

interface Props {
	/** Directory under `src/content/docs`, e.g. `llms/prompting`. */
	directory: string;
}

const { directory } = Astro.props;
const terms = (await getCollection('docs', ({ id }) => id.startsWith(`${directory}/`))).sort(
	(a, b) => (a.data.sidebar.order ?? Infinity) - (b.data.sidebar.order ?? Infinity),
);

if (terms.length === 0) throw new Error(`TermList: no terms found in "${directory}".`);
for (const { id, data } of terms) {
	if (!data.tier || !data.description) throw new Error(`TermList: "${id}" needs both \`tier\` and \`description\`.`);
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<dl class="term-list">
	{
		terms.map(({ id, data }) => (
			<div>
				<dt>
					<a href={`${base}/${id}/`}>{data.title}</a>
					{data.tier && <Badge {...tierBadges[data.tier]} />}
				</dt>
				<dd>{data.description}</dd>
			</div>
		))
	}
</dl>

<style>
	.term-list > div + div {
		margin-top: 1rem;
	}
	dt {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
	}
	dd {
		margin: 0.25rem 0 0;
	}
</style>
